# CALM project matplotlib style (light / publication).
# Generated by scripts/make_mplstyle.py from style/calm_style.py --
# edit calm_style.py, not this file.
# NOTE: hex colours are written WITHOUT a leading '#': in .mplstyle
# files '#' opens a comment and would truncate the value.
# Prefer `import calm_style as cs; cs.use_style()`, which also
# registers the calm_seq / calm_div / calm_communities colormaps.

figure.facecolor: fcfcfb
figure.edgecolor: fcfcfb
figure.dpi: 150
savefig.dpi: 400
savefig.facecolor: fcfcfb
savefig.bbox: tight
savefig.pad_inches: 0.02
savefig.transparent: False
axes.facecolor: fcfcfb
axes.edgecolor: c3c2b7
axes.labelcolor: 52514e
axes.titlecolor: 0b0b0b
axes.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
axes.grid: False
axes.axisbelow: True
axes.titlesize: 9.5
axes.titleweight: semibold
axes.titlelocation: left
axes.titlepad: 6.0
axes.labelsize: 8.5
grid.color: e1e0d9
grid.linewidth: 0.5
xtick.color: 898781
ytick.color: 898781
xtick.labelcolor: 52514e
ytick.labelcolor: 52514e
xtick.labelsize: 7.5
ytick.labelsize: 7.5
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.major.size: 3.0
ytick.major.size: 3.0
xtick.direction: out
ytick.direction: out
font.family: sans-serif
font.sans-serif: Lato, Liberation Sans, DejaVu Sans, sans-serif
font.size: 8.5
text.color: 0b0b0b
legend.frameon: False
legend.fontsize: 8.0
legend.handlelength: 1.1
legend.handleheight: 1.1
legend.borderpad: 0.0
legend.labelspacing: 0.5
legend.columnspacing: 1.2
lines.linewidth: 2.0
lines.markersize: 4.0
lines.solid_capstyle: round
patch.linewidth: 0.0
image.cmap: calm_seq
image.interpolation: nearest
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
axes.prop_cycle: cycler('color', ['E69F00', '56B4E9', '009E73', '0072B2', 'D55E00', 'CC79A7'])
